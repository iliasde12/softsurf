<%- include('partials/head') %>
  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    
    <%- include('partials/header') %>
    <div class="flex flex-1 overflow-hidden">
      <%- include('partials/aside') %>

      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <!-- Title + view toggle -->
        <div class="flex items-start justify-between mb-1">
          <div>
            <h1
              class="font-display text-3xl font-semibold tracking-tight text-light"
            >
              Mijn afspeellijsten
            </h1>
            <p class="text-[#6B6B8A] text-xs md:text-sm mb-4">
              Genereer een afspeellijst op basis van je stemming en gelikete
              nummers
            </p>
          </div>
          <div class="flex gap-2 mt-1">
            <button
              class="bg-[#7B6BF5] text-white text-xs px-3 py-1 rounded-full"
            >
              Lijst
            </button>
            <button
              class="border border-[#3A3760] text-[#A0A0C0] text-xs px-3 py-1 rounded-full hover:bg-[#1E1B3A] transition"
            >
              Raster
            </button>
          </div>
        </div>

        <!-- Search + filters -->

        <!-- hier komt generate -->
        <section
          class="flex items-center justify-between bg-[#2A2650] mb-6 w-full px-6 py-4 rounded-2xl gap-6"
        >
          <!-- Stats -->
          <div class="flex gap-4">
            <div
              class="flex flex-col gap-1 bg-[#4d467a] px-5 py-3 rounded-xl shadow-[0_4px_15px_#0000005a]"
            >
              <span class="text-zinc-400 text-[11px] uppercase tracking-widest"
                >Stemming</span
              >
              <span class="text-white text-sm font-semibold">Feest</span>
            </div>
            <div
              class="flex flex-col gap-1 bg-[#4d467a] px-5 py-3 rounded-xl shadow-[0_4px_15px_#0000005a]"
            >
              <span class="text-zinc-400 text-[11px] uppercase tracking-widest"
                >Gelikte nummers</span
              >
              <span class="text-white text-sm font-semibold">4 nummers</span>
            </div>
            <div
              class="flex flex-col gap-1 bg-[#4d467a] px-5 py-3 rounded-xl shadow-[0_4px_15px_#0000005a]"
            >
              <span class="text-zinc-400 text-[11px] uppercase tracking-widest"
                >Mix type</span
              >
              <span class="text-white text-sm font-semibold"
                >Populair + ontdekking</span
              >
            </div>
          </div>
          <!-- Button -->
          <button
            class="bg-[#934c99] hover:brightness-110 transition text-white text-sm font-semibold px-6 py-3 rounded-xl shadow-[0_4px_15px_#934c9966] whitespace-nowrap cursor-pointer"
          >
            ✦ Genereer afspeellijst
          </button>
        </section>
        <section class="flex flex-row justify-between mb-4">
          <h2>Gegenereerde Afspeellijst - 6 Nummers</h2>
          <p
            class="mr-5 pr-2.5 pl-2.5 pt-1 pb-1 rounded-[40px] border-[3px] border-[#7B6BF5] hover:bg-[#7B6BF5]"
          >
            Alles Opslaan
          </p>
        </section>

        <!-- Table header (hidden on mobile) -->
        <div
          class="hidden md:grid grid-cols-[40px_1fr_160px_100px_80px_40px] gap-2 text-[#6B6B8A] text-base uppercase tracking-widest mb-2 px-2"
        >
          <span class="text-white">#</span>
          <span class="text-white">Titel</span>
          <span class="text-white">Label</span>
          <span class="text-white">Datum</span>
          <span class="text-white">Pop</span>
          <span class="text-white"></span>
        </div>

        <!-- Tracks -->
        <div class="flex flex-col gap-1" id="tracksContainer">
  <% const moodType = ["favorieten", "chill", "workout"] %>
  <% const moodColor = ["#E91E8C", "#2A5A3A", "#1E3A5A"] %>

  <% songs.forEach((song, index) => { %>
    <div  class="grid grid-cols-[40px_1fr_40px] md:grid-cols-[40px_1fr_160px_100px_80px_40px] gap-2 items-center <%= index % 2 === 0 ? 'bg-[#1E1B3A]' : '' %> hover:bg-[#1E1B3A] rounded-xl px-2 py-2 cursor-pointer transition" >
      
      <span class="text-white text-[1rem] text-center"><%= index + 1 %></span>

      <div class="flex items-center gap-3">
        <img 
          src="<%= song.item.album.images[2].url %>" 
          alt="<%= song.item.name %>" 
          class="w-9 h-9 rounded-lg object-cover shrink-0" 
        />
        <div>
          <p class="text-white text-[1rem] font-semibold"><%= song.item.name %></p>
          <p class="text-white/60 text-[1rem]"><%= song.item.artists[0].name %></p>
        </div>
      </div>

      <span class="hidden md:block">
        <span class="text-white text-sm px-2 py-1 rounded-full" style="background-color: <%= moodColor[index % moodColor.length] %>">
          <%= moodType[index % moodType.length] %>
        </span>
      </span>

      <span class="hidden md:block text-white/60 text-sm">
        <%= new Date(song.added_at).toLocaleDateString("nl-NL", { day: "numeric", month: "short" }) %>
      </span>

      <span class="hidden md:block text-[#A0A0C0] text-sm"><%= song.item.popularity %></span>

      <span class="text-[#E91E8C] text-sm">♥</span>
    </div>
  <% }) %>
</div>


      </main>
    </div>

   <%- include('partials/footer') %>
  </body>
</html>
