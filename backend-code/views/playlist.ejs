<%- include('partials/head') %>
<script src="js/maak-playlist-mondal.js" defer></script>
  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    
    <%- include('partials/header') %>
    <div class="flex flex-1 overflow-hidden">
      <%- include('partials/aside') %>

      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <!-- Title + view toggle -->
        <div class="flex items-start justify-between mb-1 animate-fadeUp">
          <div>
            <h1
              class="font-display text-3xl font-semibold tracking-tight text-light"
            >
              Mijn afspeellijsten
            </h1>
            <p class="text-[#6B6B8A] text-xs md:text-sm mb-4">
              Genereer een afspeellijst op basis van je stemming en gelikete
              nummers
            </p>
          </div>
          <div class="flex gap-2 mt-1">
            <button
              class="bg-[#7B6BF5] text-white text-xs px-3 py-1 rounded-full"
            >
              Lijst
            </button>
            <button
              class="border border-[#3A3760] text-[#A0A0C0] text-xs px-3 py-1 rounded-full hover:bg-[#1E1B3A] transition"
            >
              Raster
            </button>
          </div>
        </div>

        <!-- Search + filters -->

        <!-- hier komt generate -->
        <section
          class="flex items-center justify-between bg-[#2A2650] mb-6 w-full px-6 py-4 rounded-2xl gap-6 animate-fadeUp"
        >
          <!-- Stats -->
          <div class="flex gap-4">
            <div
           class="flex flex-col gap-1 bg-[#4d467a] px-5 py-3 rounded-xl shadow-[0_4px_15px_#0000005a]"
         >
        <span class="text-zinc-400 text-[11px] uppercase tracking-widest"
             >Stemming</span
           >
              <span class="text-white text-sm font-semibold">Feest</span>
            </div>
            <div
              class="flex flex-col gap-1 bg-[#4d467a] px-5 py-3 rounded-xl shadow-[0_4px_15px_#0000005a]"
            >
              <span class="text-zinc-400 text-[11px] uppercase tracking-widest"
                >aantal nummers</span
              >
              <span class="text-white text-sm font-semibold">4 nummers</span>
            </div>
            <div
              class="flex flex-col gap-1 bg-[#4d467a] px-5 py-3 rounded-xl shadow-[0_4px_15px_#0000005a]"
            >
              <span class="text-zinc-400 text-[11px] uppercase tracking-widest"
                >Mix type</span
              >
              <span class="text-white text-sm font-semibold"
                >Populair + ontdekking</span
              >
            </div>
          </div>
          <!-- Button -->
          <button
            class="bg-[#934c99] hover:brightness-110 transition text-white text-sm font-semibold px-6 py-3 rounded-xl shadow-[0_4px_15px_#934c9966] whitespace-nowrap cursor-pointer"
          >
            ✦ Genereer afspeellijst
          </button>
        </section>
        <section class="flex flex-row justify-between mb-4">
          <h2><%= playlists.length + customPlaylists.length %> afspeelijsten</h2>
          <!-- <p
             class="mr-5 pr-2.5 pl-2.5 pt-1 pb-1 rounded-[40px] border-[3px] border-[#7B6BF5] hover:bg-[#7B6BF5]"
           >
             Alles Opslaan
           </p>-->
          <button
                  class="bg-[#934c99] hover:brightness-110 transition text-white text-sm font-semibold px-6 py-3 rounded-xl shadow-[0_4px_15px_#934c9966] whitespace-nowrap cursor-pointer"
            id="maak-playlist"
          >
            Maak playlist
          </button>
         </section>

        <!-- modal om playlists te maken -->
        <div id="createModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
          <div class="bg-[#1E1B3A] rounded-2xl p-6 w-full max-w-md max-h-[90vh] overflow-y-auto">
            <h2 class="text-white font-bold text-lg mb-4">Nieuwe playlist</h2>

            <form action="/playlist/create" method="POST" enctype="multipart/form-data">

              <!-- Naam -->
              <label class="text-[#6B6B8A] text-xs mb-1 block">Naam</label>
              <input name="name" type="text" placeholder="Naam playlist..."
                     class="w-full bg-[#2A2750] text-white text-sm rounded-xl px-4 py-2 mb-3 outline-none"/>

              <!-- Afbeelding -->
              <label class="text-[#6B6B8A] text-xs mb-1 block">Afbeelding</label>
              <div id="imagePreview" class="w-full h-32 bg-[#2A2750] rounded-xl flex items-center justify-center cursor-pointer hover:bg-[#33306b] transition mb-3">
                <span class="text-[#6B6B8A] text-sm">+ Klik om afbeelding te uploaden</span>
              </div>
              <input id="playlistImage" name="image" type="file" accept="image/*" class="hidden"/>

              <!-- Beschrijving -->
              <label class="text-[#6B6B8A] text-xs mb-1 block">Beschrijving</label>
              <textarea name="description" placeholder="Beschrijving..." rows="2"
                        class="w-full bg-[#2A2750] text-white text-sm rounded-xl px-4 py-2 mb-3 outline-none resize-none"></textarea>

              <!-- Zoek nummers -->
              <label class="text-[#6B6B8A] text-xs mb-1 block">Nummers toevoegen</label>
              <input id="songSearch" type="text" placeholder="Zoek nummers..."
                     class="w-full bg-[#2A2750] text-white text-sm rounded-xl px-4 py-2 mb-2 outline-none"/>

              <!-- Zoekresultaten -->
              <div id="searchResults" class="flex flex-col gap-1 max-h-40 overflow-y-auto mb-3"></div>

              <!-- Toegevoegde nummers -->
              <label class="text-[#6B6B8A] text-xs mb-1 block">Toegevoegde nummers</label>
              <div id="selectedSongs" class="flex flex-col gap-1 max-h-32 overflow-y-auto mb-4"></div>

              <!-- Hidden input voor songs -->
              <input type="hidden" name="songs" id="songsInput"/>

              <div class="flex justify-end gap-2">
                <button type="button" id="sluitModal" class="text-[#6B6B8A] text-sm px-4 py-2">Annuleren</button>
                <button type="submit" class="bg-[#E91E8C] hover:bg-[#c4177a] text-white text-sm font-semibold px-5 py-2 rounded-full transition">
                  Aanmaken
                </button>
              </div>

            </form>
          </div>
        </div>

         <!-- Table header (hidden on mobile)
         <div
           class="hidden md:grid grid-cols-[40px_1fr_160px_100px_80px_40px] gap-2 text-[#6B6B8A] text-base uppercase tracking-widest mb-2 px-2"
         >
           <span class="text-white">#</span>
           <span class="text-white">Titel</span>
           <span class="text-white">Label</span>
           <span class="text-white">Datum</span>
           <span class="text-white">Pop</span>
           <span class="text-white"></span>
         </div>-->


        <div class="grid grid-cols-2 animate-fadeUp md:grid-cols-3 lg:grid-cols-4 gap-4" id="playlistsContainer">
          <!-- Spotify playlists -->
          <% playlists.forEach((playlist) => { %>
          <a href="/playlist/songs/sp_<%= playlist.id %>">
            <div class="bg-[#1E1B3A] hover:bg-[#2A2750] rounded-xl p-4 cursor-pointer transition flex flex-col gap-3">

              <!-- Cover -->
              <% if (playlist.images && playlist.images.length > 0) { %>
                <img
                        src="<%= playlist.images[0].url %>"
                        alt="<%= playlist.name %>"
                        class="w-full aspect-square rounded-lg object-cover"
                />
              <% } else { %>
                <div class="w-full aspect-square rounded-lg bg-[#2A2750] flex items-center justify-center text-4xl">
                  🎵
                </div>
              <% } %>

              <!-- Info -->
              <div class="flex flex-col gap-1">
                <p class="text-white font-semibold text-sm truncate"><%= playlist.name %></p>
                <p class="text-white/60 text-xs truncate"><%= playlist.owner.display_name %></p>
                <span class="text-xs text-green-400">Spotify</span>
              </div>

              <!-- Footer -->
              <div class="flex items-center justify-between mt-auto">
                <span class="text-white/40 text-xs"><%= playlist.items.total %> nummers</span>
                <span class="text-[#E91E8C] text-sm">♥</span>
              </div>

            </div>
          </a>
          <% }) %>

            <!-- Eigen playlists uit database -->
            <% customPlaylists.forEach((playlist) => { %>
            <a href="/playlist/songs/db_<%= playlist._id %>">
                <div class="bg-[#1E1B3A] hover:bg-[#2A2750] rounded-xl p-4 cursor-pointer transition flex flex-col gap-3">

                  <!-- Cover -->
                  <% if (playlist.image) { %>
                    <img src="/uploads/<%= playlist.image %>" alt="<%= playlist.name %>"
                         class="w-full aspect-square rounded-lg object-cover"/>
                  <% } else { %>
                    <div class="w-full aspect-square rounded-lg bg-[#2A2750] flex items-center justify-center text-4xl">
                      🎵
                    </div>
                  <% } %>

                  <!-- Info -->
                  <div class="flex flex-col gap-1">
                    <p class="text-white font-semibold text-sm truncate"><%= playlist.name %></p>
                    <p class="text-white/60 text-xs truncate"><%= playlist.description || '' %></p>
                    <span class="text-xs text-[#E91E8C]">Music Match</span>
                  </div>

                  <!-- Footer -->
                  <div class="flex items-center justify-between mt-auto">
                    <span class="text-white/40 text-xs"><%= playlist.songs?.length || 0 %> nummers</span>
                    <span class="text-[#E91E8C] text-sm">♥</span>
                  </div>

                </div>
              </a>
            <% }) %>

        </div>


      </main>
    </div>

   <%- include('partials/footer') %>
  </body>
</html>
