<aside class="hidden md:flex w-[20%] bg-[#100E22] flex-col justify-between py-4 px-4 overflow-y-auto">
  <div>
    <div class="flex items-center gap-2 mb-6">
      <div class="w-8 h-8 rounded-full bg-[#7B6BF5] flex items-center justify-center text-xs font-bold">M</div>
      <span class="font-bold text-white text-[1rem]">MusicMatch</span>
    </div>

    <p class="text-[#6B6B8A] text-sm uppercase font-semibold mb-2 tracking-widest">Ontdekken</p>
    <nav class="flex flex-col gap-1 mb-6">
      <a href="/search" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/search' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
        <img class="w-5" src="/img/magnifying-glass-solid-full (2).svg" alt="" />
        <span>Zoeken</span>
      </a>
     <a href="/vergelijken-artiesten" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/vergelijken-artiesten' || currentPath === '/vergelijken-nummers' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
    <img class="w-5" src="/img/square.svg" alt="" />
    <span>Vergelijken</span>
</a>
      <a href="/mood" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/mood' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
        <img class="w-5" src="/img/emoiji.svg" alt="" />
        <span>Stemming</span>
      </a>
        <a href="/songs" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/songs' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
            <img class="w-5" src="/img/music-solid-full.svg" alt="" />
            <span>Nummers</span>
        </a>
    </nav>

    <p class="text-[#6B6B8A] text-sm uppercase font-semibold mb-2 tracking-widest">Bibliotheek</p>
    <nav class="flex flex-col gap-1 mb-6">
      <a href="/collectie" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/collectie' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
        <img class="w-5" src="/img/withart.svg" alt="" />
        <span>Mijn Collectie</span>
      </a>
      <a href="/playlists" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/playlists' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
        <img class="w-5" src="/img/music-solid-full.svg" alt="" />
        <span>Afspeellijsten</span>
      </a>
    </nav>

      <p class="text-[#6B6B8A] text-sm uppercase font-semibold mb-2 tracking-widest">Spelletjes</p>
      <nav class="flex flex-col gap-1">
          <a href="/leaderboard" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/leaderboard' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
              <img class="w-5" src="/img/trophy-solid-full.svg" alt="" />
              <span>Leaderboard</span>
          </a>
          <a href="/guessthesong" class="flex items-center gap-2 text-[1rem] py-1 px-2 rounded-lg transition <%= currentPath === '/guessthesong' ? 'text-white bg-[#7B6BF5]' : 'text-[#A0A0C0] hover:text-white hover:bg-[#1E1B3A]' %>">
              <img class="w-5" src="/img/question-solid-full.svg" alt="" />
              <span>Raad het Nummer</span>
          </a>

      </nav>
  </div>

  <div class="flex items-center gap-2 border-t border-[#1E1B3A] pt-4">
    <a href="/account">
      <img src="<%= user.avatar.url %>" alt="<%= user.avatar.alt %>" width="35" height="35" class="rounded-full" />
    </a>
    <div class="flex items-center justify-between flex-1">
      <div>
        <p class="text-white text-sm font-semibold"><%= user.username %></p>
        <p class="text-[#7B6BF5] text-xs">● Feest-stemming</p>
      </div>
      <!--logout button -->
  <form action="/logout" method="POST">
    <button type="submit" class="group flex items-center justify-start w-[30px] h-[30px] rounded-full cursor-pointer relative overflow-hidden bg-[#ff4141] hover:w-[32px] hover:h-[32px]">
        <div class="w-full transition-all duration-300 flex items-center justify-center">
            <svg class="w-[17px]" viewBox="0 0 512 512">
                <path class="fill-white" d="M377.9 105.9L500.7 228.7c7.2 7.2 11.3 17.1 11.3 27.3s-4.1 20.1-11.3 27.3L377.9 406.1c-6.4 6.4-15 9.9-24 9.9c-18.7 0-33.9-15.2-33.9-33.9l0-62.1-128 0c-17.7 0-32-14.3-32-32l0-64c0-17.7 14.3-32 32-32l128 0 0-62.1c0-18.7 15.2-33.9 33.9-33.9c9 0 17.6 3.6 24 9.9zM160 96L96 96c-17.7 0-32 14.3-32 32l0 256c0 17.7 14.3 32 32 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-64 0c-53 0-96-43-96-96L0 128C0 75 43 32 96 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32z"/>
            </svg>
        </div>
    </button>
  </form>
    </div>
  </div>
</aside>