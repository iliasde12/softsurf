<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="./img/softsurf_logo.svg" />
    <script src="js/search.js" defer></script>
    <title>Zoeken</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"halyard-display"', "sans-serif"],
              body: ['"halyard-text"', "sans-serif"],
            },
            colors: {
              base: "#0f0e17",
              surface: "#1a1828",
              card: "#221f33",
              border: "#2e2b42",
              accent: "#7c6aff",
              green: "#4ade80",
              red: "#f87171",
              muted: "#6b6889",
              light: "#e8e6f0",
            },
            keyframes: {
              fadeUp: {
                "0%": { opacity: "0", transform: "translateY(14px)" },
                "100%": { opacity: "1", transform: "translateY(0)" },
              },
            },
            animation: {
              fadeUp: "fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both",
            },
          },
        },
      };
    </script>
  </head>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <!-- HEADER -->
    <header
      class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start"
    >
      <button class="md:hidden text-white text-xl">☰</button>
      <img
        src="/img/softsurf_logo.svg"
        alt="softsurf_logo"
        class="w-28 md:w-30 mx-auto md:mx-0"
      />
      <div class="md:hidden w-6"></div>
    </header>

    <div class="flex flex-1 overflow-hidden">
      <%- include('partials/aside') %>
      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <!-- Title + view toggle -->
        <div class="flex items-start justify-between mb-1 animate-fadeUp">
          <div>
            <h1
              class="font-display text-3xl font-semibold tracking-tight text-light"
            >
              Zoeken
            </h1>
            <p class="text-[#6B6B8A] text-xs md:text-sm mb-4">
              Vind artiesten, nummers en albums via MusicMatch
            </p>
          </div>
          <div class="flex gap-2 mt-1">
            <button
              class="bg-[#7B6BF5] text-white text-xs px-3 py-1 rounded-full"
              id="lijstBtn"
            >
              Lijst
            </button>
            <button
              class="border border-[#3A3760] text-[#A0A0C0] text-xs px-3 py-1 rounded-full hover:bg-[#1E1B3A] transition"
              id="rasterBtn"
            >
              Raster
            </button>
          </div>
        </div>

        <!-- nieuwe search -->
        <div
          class="relative animate-fadeUp mb-6"
          style="animation-delay: 0.05s"
        >
          <svg
            class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input
            type="search"
            placeholder="Zoek een nummer…"
            class="w-full bg-surface border border-border rounded-xl pl-10 pr-4 py-2.5 text-sm text-light placeholder-muted outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition"
            id="searchInput"
          />
        </div>

        <!-- Tracks -->
        <div class="flex flex-col gap-1" id="containerSongs">
        </div>

        <!-- Modal voor toe tevoegen in playlist -->
        <div id="addSongModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
          <div class="bg-[#1E1B3A] rounded-2xl p-6 w-full max-w-sm">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-white font-bold text-lg">Toevoegen aan playlist</h2>
              <button id="sluitAddModal" class="text-[#6B6B8A] hover:text-white text-xl">✕</button>
            </div>
            <div id="playlistList" class="flex flex-col gap-2 max-h-60 overflow-y-auto"></div>
          </div>
        </div>

      </main>
    </div>

    <!-- FOOTER -->
    <footer
      class="bg-[#100E22] h-16 flex items-center px-4 md:px-6 gap-4 border-t border-[#1E1B3A] shrink-0"
    >
      <div class="flex items-center gap-3 flex-1 md:w-[20%] md:flex-none">
        <div
          class="w-10 h-10 bg-[#2A1B4A] rounded-lg flex items-center justify-center text-sm shrink-0"
        >
          🎵
        </div>
        <div>
          <p class="text-white text-[1rem] font-semibold">Last Last</p>
          <p class="text-white/75 text-[15px]">Burna Boy</p>
        </div>
      </div>

      <div class="hidden md:flex flex-col items-center flex-1 gap-1">
        <div class="flex items-center gap-4">
          <button class="text-[#A0A0C0] hover:text-white text-sm">
            <img class="w-6" src="img/left.svg" alt="" />
          </button>
          <button
            class="flex items-center justify-center text-black text-[1rem]"
          >
            <img class="w-6" src="img/pause.svg" alt="" />
          </button>
          <button class="text-[#A0A0C0] hover:text-white text-[1rem]">
            <img class="w-6" src="img/right.svg" alt="" />
          </button>
        </div>
        <div class="flex items-center gap-2 w-full max-w-md">
          <span class="text-[#6B6B8A] text-[1rem]">1:22</span>
          <div class="flex-1 h-1 bg-[#1E1B3A] rounded-full">
            <div class="w-[40%] h-full bg-[#7B6BF5] rounded-full"></div>
          </div>
          <span class="text-[#6B6B8A] text-[1rem]">4:08</span>
        </div>
      </div>

      <button
        class="md:hidden flex items-center justify-center text-black text-[1rem] shrink-0"
      >
        <img class="w-6" src="img/pause.svg" alt="" />
      </button>

      <div class="hidden md:flex items-center gap-2 w-[20%] justify-end">
        <span class="text-[#6B6B8A] text-[1rem]"
          ><img class="w-6" src="img/volume-solid-full.svg" alt=""
        /></span>
        <div class="w-20 h-1 bg-[#1E1B3A] rounded-full">
          <div class="w-[70%] h-full bg-[#7B6BF5] rounded-full"></div>
        </div>
      </div>
    </footer>
  </body>
</html>
