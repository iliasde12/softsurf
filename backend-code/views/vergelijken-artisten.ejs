<!doctype html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="./img/softsurf_logo.svg" />
  <script src="/js/artisten.js" defer></script>
  <title>Vergelijken-artiesten</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"halyard-display"', "sans-serif"],
            body: ['"halyard-text"', "sans-serif"],
          },
          colors: {
            base: "#0f0e17",
            surface: "#1a1828",
            card: "#221f33",
            border: "#2e2b42",
            accent: "#7c6aff",
            green: "#4ade80",
            red: "#f87171",
            muted: "#6b6889",
            light: "#e8e6f0",
          },
          keyframes: {
            fadeUp: {
              "0%": { opacity: "0", transform: "translateY(14px)" },
              "100%": { opacity: "1", transform: "translateY(0)" },
            },
          },
          animation: {
            fadeUp: "fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both",
          },
        },
      },
    };
  </script>
</head>

<body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
<!-- HEADER -->
<header class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start">
  <button class="md:hidden text-white text-xl">☰</button>
  <img src="/img/softsurf_logo.svg" alt="softsurf_logo" class="w-28 md:w-30 mx-auto md:mx-0" />
  <div class="md:hidden w-6"></div>
</header>

<div class="flex flex-1 overflow-hidden">
  <%- include('partials/aside') %>

  <!-- MAIN -->
  <main class="flex-1 p-4 md:p-6 overflow-y-auto">

    <!-- Title -->
    <div class="animate-fadeUp mb-4">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-light">Vergelijken</h1>
      <p class="mt-1 text-base text-muted">Selecteer twee artiesten om hun statistieken naast elkaar te zien</p>
    </div>

    <!-- Search -->
    <div class="relative animate-fadeUp mb-6" style="animation-delay:0.05s">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
              type="search"
              placeholder="Zoek een artiest…"
              class="w-full bg-surface border border-border rounded-xl pl-10 pr-4 py-2.5 text-sm text-light placeholder-muted outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition"
      />
    </div>

    <!-- Tabs -->
    <div class="flex gap-2 mb-8 animate-fadeUp" style="animation-delay:0.1s">
      <a href="/vergelijken-artiesten" class="px-4 py-1.5 rounded-full text-sm font-medium bg-gradient-to-br from-accent to-violet-400 text-white shadow-lg shadow-accent/30 border border-transparent">Artiesten</a>
      <a href="/vergelijken-nummers" class="px-4 py-1.5 rounded-full text-sm font-medium border border-border text-muted hover:text-light hover:border-violet-700 transition">Nummers</a>
    </div>

    <!-- Compare grid -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-4 items-start animate-fadeUp" style="animation-delay:0.15s">

      <!-- ── Eerste artiest ── -->
      <div class="bg-gradient-to-b from-card to-surface border border-border rounded-2xl overflow-hidden shadow-xl transition hover:border-accent/40">
        <div class="flex flex-col items-center gap-3 px-6 pt-7 pb-5 border-b border-border">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center shadow-lg overflow-hidden bg-surface">
            <img id="profiel-pic-eerste-artist" class="w-full h-full object-cover rounded-xl" src="" alt="" />
          </div>
          <div class="text-center">
            <h2 class="font-display text-xl font-semibold text-light" id="naam-eerste-artist">–</h2>
            <p class="text-[1rem] text-muted mt-0.5">Artiest</p>
          </div>
        </div>
        <div class="px-5 py-2">

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Populariteit</span>
              <span id="pop-icoon-eerste" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="pop-eerste-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="pop-bar-eerste" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Volgers</span>
              <span id="followers-icoon-eerste" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="followers-eerste-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="followers-bar-eerste" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Albums</span>
              <span id="albums-icoon-eerste" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="albums-eerste-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="albums-bar-eerste" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Maandelijkse luisteraars</span>
              <span id="luisteraars-icoon-eerste" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="luisteraars-eerste-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="luisteraars-bar-eerste" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 flex justify-between items-center px-1">
            <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Genre</span>
            <span id="genre-eerste-artist" class="text-[0.7rem] font-semibold px-3 py-1 rounded-full bg-accent/10 text-violet-400 border border-accent/20">–</span>
          </div>

        </div>
      </div>

      <!-- VS -->
      <div class="flex items-center justify-center py-8 md:py-0 md:mt-28">
        <div class="w-12 h-12 rounded-full flex items-center justify-center text-xs font-bold text-white tracking-widest"
             style="background:linear-gradient(135deg,#5b3fe8,#7c6aff);box-shadow:0 0 0 3px rgba(124,106,255,0.22),0 0 24px rgba(124,106,255,0.18)">
          VS
        </div>
      </div>

      <!-- ── Tweede artiest ── -->
      <div class="bg-gradient-to-b from-card to-surface border border-border rounded-2xl overflow-hidden shadow-xl transition hover:border-accent/40">
        <div class="flex flex-col items-center gap-3 px-6 pt-7 pb-5 border-b border-border">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center shadow-lg overflow-hidden bg-surface">
            <img id="profiel-pic-tweede-artist" class="w-full h-full object-cover rounded-xl" src="" alt="" />
          </div>
          <div class="text-center">
            <h2 class="font-display text-xl font-semibold text-light" id="naam-tweede-artist">–</h2>
            <p class="text-[1rem] text-muted mt-0.5">Artiest</p>
          </div>
        </div>
        <div class="px-5 py-2">

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Populariteit</span>
              <span id="pop-icoon-tweede" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="pop-tweede-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="pop-bar-tweede" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Volgers</span>
              <span id="followers-icoon-tweede" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="followers-tweede-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="followers-bar-tweede" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Albums</span>
              <span id="albums-icoon-tweede" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="albums-tweede-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="albums-bar-tweede" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
            <div class="flex justify-between items-center">
              <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Maandelijkse luisteraars</span>
              <span id="luisteraars-icoon-tweede" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span class="w-[20px] h-[20px]"></span>
                    <span id="luisteraars-tweede-artist">–</span>
                  </span>
            </div>
            <div class="mt-1.5 h-0.5 bg-border rounded-full">
              <div id="luisteraars-bar-tweede" class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400" style="width:0%"></div>
            </div>
          </div>

          <div class="py-3.5 flex justify-between items-center px-1">
            <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Genre</span>
            <span id="genre-tweede-artist" class="text-[0.7rem] font-semibold px-3 py-1 rounded-full bg-accent/10 text-violet-400 border border-accent/20">–</span>
          </div>

        </div>
      </div>

    </div>
    <!-- /grid -->

    <!-- Summary -->
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border border-border bg-card/50 rounded-xl px-6 py-4 animate-fadeUp" style="animation-delay:0.2s">
      <p class="text-sm text-muted" id="summary-tekst">Selecteer twee artiesten om de vergelijking te zien.</p>
      <div class="flex gap-4 shrink-0">
            <span class="flex items-center gap-1.5 text-[1rem] text-green font-medium">
              <svg width="15" height="15" viewBox="0 0 12 12" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6 5,9 10,3"/></svg>
              Winnaar
            </span>
        <span class="flex items-center gap-1.5 text-[1rem] text-red font-medium">
              <svg width="15" height="15" viewBox="0 0 12 12" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round"><line x1="3" y1="3" x2="9" y2="9"/><line x1="9" y1="3" x2="3" y2="9"/></svg>
              Lager
            </span>
      </div>
    </div>

  </main>
</div>

<!-- FOOTER -->
<footer class="bg-[#100E22] h-16 flex items-center px-4 md:px-6 gap-4 border-t border-[#1E1B3A] shrink-0">
  <div class="flex items-center gap-3 flex-1 md:w-[20%] md:flex-none">
    <div class="w-10 h-10 bg-[#2A1B4A] rounded-lg flex items-center justify-center text-sm shrink-0">🎵</div>
    <div>
      <p class="text-white text-[1rem] font-semibold">Last Last</p>
      <p class="text-white/75 text-[15px]">Burna Boy</p>
    </div>
  </div>
  <div class="hidden md:flex flex-col items-center flex-1 gap-1">
    <div class="flex items-center gap-4">
      <button class="text-[#A0A0C0] hover:text-white text-sm"><img class="w-6" src="img/left.svg" alt="" /></button>
      <button class="flex items-center justify-center text-black text-[1rem]"><img class="w-6" src="img/pause.svg" alt="" /></button>
      <button class="text-[#A0A0C0] hover:text-white text-[1rem]"><img class="w-6" src="img/right.svg" alt="" /></button>
    </div>
    <div class="flex items-center gap-2 w-full max-w-md">
      <span class="text-[#6B6B8A] text-[1rem]">1:22</span>
      <div class="flex-1 h-1 bg-[#1E1B3A] rounded-full"><div class="w-[40%] h-full bg-[#7B6BF5] rounded-full"></div></div>
      <span class="text-[#6B6B8A] text-[1rem]">4:08</span>
    </div>
  </div>
  <button class="md:hidden flex items-center justify-center text-black text-[1rem] shrink-0"><img class="w-6" src="img/pause.svg" alt="" /></button>
  <div class="hidden md:flex items-center gap-2 w-[20%] justify-end">
    <span class="text-[#6B6B8A] text-[1rem]"><img class="w-6" src="img/volume-solid-full.svg" alt="" /></span>
    <div class="w-20 h-1 bg-[#1E1B3A] rounded-full"><div class="w-[70%] h-full bg-[#7B6BF5] rounded-full"></div></div>
  </div>
</footer>
</body>
</html>