<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="./img/softsurf_logo.svg" />
    <script src="js/userData.js" defer></script>
    <script src="js/artisten.js" defer></script>
    <title>Raad-het-nummer</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"halyard-display"', "sans-serif"],
              body: ['"halyard-text"', "sans-serif"],
            },
            colors: {
              base: "#0f0e17",
              surface: "#1a1828",
              card: "#221f33",
              border: "#2e2b42",
              accent: "#7c6aff",
              green: "#4ade80",
              red: "#f87171",
              muted: "#6b6889",
              light: "#e8e6f0",
            },
            keyframes: {
              fadeUp: {
                "0%": { opacity: "0", transform: "translateY(14px)" },
                "100%": { opacity: "1", transform: "translateY(0)" },
              },
            },
            animation: {
              fadeUp: "fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both",
            },
          },
        },
      };
    </script>
  </head>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <!-- HEADER -->
    <header
      class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start"
    >
      <button class="md:hidden text-white text-xl">☰</button>
      <img
        src="/img/softsurf_logo.svg"
        alt="softsurf_logo"
        class="w-28 md:w-30 mx-auto md:mx-0"
      />
      <div class="md:hidden w-6"></div>
    </header>

    <div class="flex flex-1 overflow-hidden">
      <%- include('partials/aside') %>
      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-8 overflow-y-auto">
        <div class="flex flex-col items-center max-w-xl mx-auto animate-fadeUp">
          <!-- Titel -->
          <h1
            class="font-extrabold tracking-tight mb-2 text-center"
            style="font-size: 2rem"
          >
            Raad het Nummer
          </h1>
          <p class="mb-8 text-center" style="font-size: 1rem; color: #7b7a9a">
            Luister naar een preview en raad welk nummer het is
          </p>

          <!-- Stats -->
          <div class="flex gap-10 mb-8">
            <div class="text-center">
              <p
                class="font-extrabold"
                style="font-size: 2.25rem; color: #5efca0; line-height: 1"
              >
                7
              </p>
              <p
                style="
                  font-size: 0.75rem;
                  letter-spacing: 0.1em;
                  text-transform: uppercase;
                  color: #5b5a7a;
                  margin-top: 0.35rem;
                  font-weight: 500;
                "
              >
                Goed
              </p>
            </div>
            <div class="text-center">
              <p
                class="font-extrabold"
                style="font-size: 2.25rem; color: #a79bfa; line-height: 1"
              >
                12
              </p>
              <p
                style="
                  font-size: 0.75rem;
                  letter-spacing: 0.1em;
                  text-transform: uppercase;
                  color: #5b5a7a;
                  margin-top: 0.35rem;
                  font-weight: 500;
                "
              >
                Totaal
              </p>
            </div>
            <div class="text-center">
              <p
                class="font-extrabold"
                style="font-size: 2.25rem; color: #ff6b8a; line-height: 1"
              >
                3
              </p>
              <p
                style="
                  font-size: 0.75rem;
                  letter-spacing: 0.1em;
                  text-transform: uppercase;
                  color: #5b5a7a;
                  margin-top: 0.35rem;
                  font-weight: 500;
                "
              >
                Reeks
              </p>
            </div>
          </div>

          <!-- Vinyl Card -->
          <div
            class="w-full rounded-2xl flex flex-col items-center px-8 py-8 mb-4"
            style="background: #1a1730; border: 1px solid #2a2648"
          >
            <!-- Vinyl disc -->
            <div class="relative mb-6" style="width: 10rem; height: 10rem">
              <div
                id="vinylDisc"
                class="rounded-full flex items-center justify-center relative"
                style="width: 10rem; height: 10rem; background: #f07090"
              >
                <div
                  class="absolute inset-0 rounded-full pointer-events-none"
                  style="border: 6px solid #e0607f; opacity: 0.3"
                ></div>
                <div
                  class="absolute rounded-full pointer-events-none"
                  style="inset: 1rem; border: 4px solid #e0607f; opacity: 0.2"
                ></div>
                <div
                  class="rounded-full"
                  style="width: 2.5rem; height: 2.5rem; background: #0d0b1e"
                ></div>
              </div>

              <!-- Play / Pause knop -->
              <button
                id="playBtn"
                class="absolute rounded-full flex items-center justify-center z-10"
                style="
                  top: 50%;
                  left: 50%;
                  transform: translate(-50%, -50%);
                  width: 2.75rem;
                  height: 2.75rem;
                  background: rgba(255, 255, 255, 0.92);
                  border: none;
                  cursor: pointer;
                "
              >
                <svg
                  id="playIcon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="#0D0B1E"
                >
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </button>
            </div>

            <!-- Hint dots -->
            <div class="flex gap-2 mb-2">
              <div
                class="rounded-full"
                style="width: 0.65rem; height: 0.65rem; background: #7b6bf5"
              ></div>
              <div
                class="rounded-full"
                style="width: 0.65rem; height: 0.65rem; background: #7b6bf5"
              ></div>
              <div
                class="rounded-full"
                style="width: 0.65rem; height: 0.65rem; background: #7b6bf5"
              ></div>
              <div
                class="rounded-full"
                style="width: 0.65rem; height: 0.65rem; background: #2e2b4e"
              ></div>
              <div
                class="rounded-full"
                style="width: 0.65rem; height: 0.65rem; background: #2e2b4e"
              ></div>
              <div
                class="rounded-full"
                style="width: 0.65rem; height: 0.65rem; background: #2e2b4e"
              ></div>
            </div>

            <p class="mb-5" style="font-size: 1rem; color: #5b5a7a">
              Artiest verborgen
            </p>

            <!-- Progress bar -->
            <div
              class="w-full rounded-full overflow-hidden"
              style="height: 3px; background: #2a2648"
            >
              <div
                id="progressBar"
                class="progress-fill rounded-full"
                style="height: 100%; width: 34%; transition: width 0.2s"
              ></div>
            </div>
          </div>

          <!-- Input + indienen -->
          <div class="flex gap-3 w-full mb-3">
            <input
              id="guessInput"
              type="text"
              placeholder="Typ een nummer..."
              class="flex-1 rounded-full px-5 py-3 transition-colors"
              style="
                font-size: 1rem;
                background: #1a1730;
                border: 1px solid #2e2b4e;
                color: #fff;
              "
            />
            <button
              class="rounded-full px-6 py-3 font-semibold whitespace-nowrap"
              style="
                font-size: 1rem;
                background: #7b6bf5;
                border: none;
                color: #fff;
                cursor: pointer;
              "
            >
              Indienen
            </button>
          </div>

          <!-- Suggesties -->
          <div
            class="w-full rounded-2xl overflow-hidden"
            style="background: #1a1730; border: 1px solid #2a2648"
          >
            <div
              class="suggestion-row flex items-center gap-4 px-5 py-4"
              style="border-bottom: 1px solid #1f1d38"
            >
              <div
                class="rounded-lg flex-shrink-0 flex items-center justify-center"
                style="width: 2.5rem; height: 2.5rem; background: #2a2648"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#5B5A7A">
                  <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3z" />
                </svg>
              </div>
              <span style="font-size: 1rem">
                <span style="font-weight: 600; color: #e2e0ff">Last Last</span>
                <span style="color: #5b5a7a">· Burna Boy</span>
              </span>
            </div>

            <div
              class="suggestion-row flex items-center gap-4 px-5 py-4"
              style="border-bottom: 1px solid #1f1d38"
            >
              <div
                class="rounded-lg flex-shrink-0 flex items-center justify-center"
                style="width: 2.5rem; height: 2.5rem; background: #2a2648"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#5B5A7A">
                  <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3z" />
                </svg>
              </div>
              <span style="font-size: 1rem">
                <span style="font-weight: 600; color: #e2e0ff">Last Lap</span>
                <span style="color: #5b5a7a">· Burna Boy</span>
              </span>
            </div>

            <div class="suggestion-row flex items-center gap-4 px-5 py-4">
              <div
                class="rounded-lg flex-shrink-0 flex items-center justify-center"
                style="width: 2.5rem; height: 2.5rem; background: #2a2648"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#5B5A7A">
                  <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3z" />
                </svg>
              </div>
              <span style="font-size: 1rem">
                <span style="font-weight: 600; color: #e2e0ff">Last Time</span>
                <span style="color: #5b5a7a">· Giveon</span>
              </span>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- FOOTER -->
    <footer
      class="bg-[#100E22] h-16 flex items-center px-4 md:px-6 gap-4 border-t border-[#1E1B3A] shrink-0"
    >
      <div class="flex items-center gap-3 flex-1 md:w-[20%] md:flex-none">
        <div
          class="w-10 h-10 bg-[#2A1B4A] rounded-lg flex items-center justify-center text-sm shrink-0"
        >
          🎵
        </div>
        <div>
          <p class="text-white text-[1rem] font-semibold">Last Last</p>
          <p class="text-white/75 text-[15px]">Burna Boy</p>
        </div>
      </div>

      <div class="hidden md:flex flex-col items-center flex-1 gap-1">
        <div class="flex items-center gap-4">
          <button class="text-[#A0A0C0] hover:text-white text-sm">
            <img class="w-6" src="img/left.svg" alt="" />
          </button>
          <button
            class="flex items-center justify-center text-black text-[1rem]"
          >
            <img class="w-6" src="img/pause.svg" alt="" />
          </button>
          <button class="text-[#A0A0C0] hover:text-white text-[1rem]">
            <img class="w-6" src="img/right.svg" alt="" />
          </button>
        </div>
        <div class="flex items-center gap-2 w-full max-w-md">
          <span class="text-[#6B6B8A] text-[1rem]">1:22</span>
          <div class="flex-1 h-1 bg-[#1E1B3A] rounded-full">
            <div class="w-[40%] h-full bg-[#7B6BF5] rounded-full"></div>
          </div>
          <span class="text-[#6B6B8A] text-[1rem]">4:08</span>
        </div>
      </div>

      <button
        class="md:hidden flex items-center justify-center text-black text-[1rem] shrink-0"
      >
        <img class="w-6" src="img/pause.svg" alt="" />
      </button>

      <div class="hidden md:flex items-center gap-2 w-[20%] justify-end">
        <span class="text-[#6B6B8A] text-[1rem]"
          ><img class="w-6" src="img/volume-solid-full.svg" alt=""
        /></span>
        <div class="w-20 h-1 bg-[#1E1B3A] rounded-full">
          <div class="w-[70%] h-full bg-[#7B6BF5] rounded-full"></div>
        </div>
      </div>
    </footer>
  </body>
</html>
