<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="./img/softsurf_logo.svg" />
    <script src="js/userData.js" defer></script>
    <title>stemming</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"halyard-display"', "sans-serif"],
              body: ['"halyard-text"', "sans-serif"],
            },
            colors: {
              base: "#0f0e17",
              surface: "#1a1828",
              card: "#221f33",
              border: "#2e2b42",
              accent: "#7c6aff",
              green: "#4ade80",
              red: "#f87171",
              muted: "#6b6889",
              light: "#e8e6f0",
            },
            keyframes: {
              fadeUp: {
                "0%": { opacity: "0", transform: "translateY(14px)" },
                "100%": { opacity: "1", transform: "translateY(0)" },
              },
            },
            animation: {
              fadeUp: "fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both",
            },
          },
        },
      };
    </script>
  </head>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <!-- HEADER -->
    <header class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start">
      <button class="md:hidden text-white text-xl">☰</button>
      <img src="/img/softsurf_logo.svg" alt="softsurf_logo" class="w-28 md:w-30 mx-auto md:mx-0" />
      <div class="md:hidden w-6"></div>
    </header>

    <div class="flex flex-1 overflow-hidden">
       <%- include('partials/aside') %>

      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <h1 class="font-display text-3xl font-semibold tracking-tight text-light">Stel Je Stemming In</h1>
        <p class="text-[#6B6B8A] text-xs md:text-sm mb-6">Je huidige stemming beïnvloedt aanbevelingen en de playlist generator</p>

        <!-- Mood knoppen: 2 cols mobile, 6 cols desktop -->
        <div class="grid grid-cols-2 md:grid-cols-6 gap-3 mb-8">
          <div class="bg-[#1E1B3A] rounded-xl p-4 text-center hover:bg-[#2A2650] cursor-pointer transition">
            <div class="text-2xl mb-2">😊</div>
            <p class="text-white text-xs font-semibold">Chill</p>
            <p class="text-[#6B6B8A] text-[10px]">Ontspannen & rustig</p>
          </div>
          <div class="bg-[#1B3A2A] rounded-xl p-4 text-center hover:bg-[#1E4A33] cursor-pointer transition">
            <div class="text-2xl mb-2">🎯</div>
            <p class="text-white text-xs font-semibold">Focus</p>
            <p class="text-[#6B6B8A] text-[10px]">Diepe concentratie</p>
          </div>
          <div class="bg-[#3A1B2A] rounded-xl p-4 text-center border-2 border-[#7B6BF5] cursor-pointer transition">
            <div class="text-2xl mb-2">🎉</div>
            <p class="text-white text-xs font-semibold">Feest</p>
            <p class="text-[#6B6B8A] text-[10px]">Hoge energie brengen</p>
          </div>
          <div class="bg-[#1E1B3A] rounded-xl p-4 text-center hover:bg-[#2A2650] cursor-pointer transition">
            <div class="text-2xl mb-2">🌧️</div>
            <p class="text-white text-xs font-semibold">Verdrietig</p>
            <p class="text-[#6B6B8A] text-[10px]">Melancholisch & reflectief</p>
          </div>
          <div class="bg-[#1E1B3A] rounded-xl p-4 text-center hover:bg-[#2A2650] cursor-pointer transition">
            <div class="text-2xl mb-2">💪</div>
            <p class="text-white text-xs font-semibold">Workout</p>
            <p class="text-[#6B6B8A] text-[10px]">Opzwepende nummers</p>
          </div>
          <div class="bg-[#1E1B3A] rounded-xl p-4 text-center hover:bg-[#2A2650] cursor-pointer transition">
            <div class="text-2xl mb-2">✨</div>
            <p class="text-white text-xs font-semibold">Aangepast</p>
            <p class="text-[#6B6B8A] text-[10px]">Maak je eigen stemming</p>
          </div>
        </div>

        <!-- Aanbevolen -->
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-base md:text-lg font-bold">Aanbevolen voor Feest</h2>
          <button class="border border-[#3A3760] text-[#A0A0C0] text-xs px-3 py-1 rounded-full hover:bg-[#1E1B3A] transition">Alles Bekijken</button>
        </div>

        <!-- 2 cols mobile, 4 cols desktop -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-gradient-to-br from-[#2A1B4A] to-[#1B1B3A] rounded-xl p-3 hover:scale-105 transition cursor-pointer">
            <div class="w-full h-24 md:h-28 bg-gradient-to-br from-[#3A2A5A] to-[#2A1B4A] rounded-lg mb-3 flex items-center justify-center text-2xl">🎵</div>
            <p class="text-white text-sm font-semibold">Ye</p>
            <p class="text-[#6B6B8A] text-xs">Burna Boy</p>
          </div>
          <div class="bg-gradient-to-br from-[#4A1B4A] to-[#2A1B3A] rounded-xl p-3 hover:scale-105 transition cursor-pointer">
            <div class="w-full h-24 md:h-28 bg-gradient-to-br from-[#7B2A7B] to-[#4A1B5A] rounded-lg mb-3 flex items-center justify-center text-2xl">🎵</div>
            <p class="text-white text-sm font-semibold">Mood</p>
            <p class="text-[#6B6B8A] text-xs">24kGoldn ft. Iann Dior</p>
          </div>
          <div class="bg-gradient-to-br from-[#4A1B2A] to-[#2A1B3A] rounded-xl p-3 hover:scale-105 transition cursor-pointer">
            <div class="w-full h-24 md:h-28 bg-gradient-to-br from-[#7B2A3A] to-[#4A1B2A] rounded-lg mb-3 flex items-center justify-center text-2xl">🎵</div>
            <p class="text-white text-sm font-semibold">Calm Down</p>
            <p class="text-[#6B6B8A] text-xs">Rema</p>
          </div>
          <div class="bg-gradient-to-br from-[#1B2A4A] to-[#1B1B3A] rounded-xl p-3 hover:scale-105 transition cursor-pointer">
            <div class="w-full h-24 md:h-28 bg-gradient-to-br from-[#2A3A7B] to-[#1B2A5A] rounded-lg mb-3 flex items-center justify-center text-2xl">🎵</div>
            <p class="text-white text-sm font-semibold">Rush</p>
            <p class="text-[#6B6B8A] text-xs">Ayra Starr</p>
          </div>
        </div>
      </main>
    </div>

    <!-- FOOTER -->
    <footer class="bg-[#100E22] h-16 flex items-center px-4 md:px-6 gap-4 border-t border-[#1E1B3A] shrink-0">
      <div class="flex items-center gap-3 flex-1 md:w-[20%] md:flex-none">
        <div class="w-10 h-10 bg-[#2A1B4A] rounded-lg flex items-center justify-center text-sm shrink-0">🎵</div>
        <div>
          <p class="text-white text-[1rem] font-semibold">Last Last</p>
          <p class="text-white/75 text-[15px]">Burna Boy</p>
        </div>
      </div>

      <div class="hidden md:flex flex-col items-center flex-1 gap-1">
        <div class="flex items-center gap-4">
          <button class="text-[#A0A0C0] hover:text-white text-sm">
            <img class="w-6" src="img/left.svg" alt="" />
          </button>
          <button class="flex items-center justify-center text-black text-[1rem]">
            <img class="w-6" src="img/pause.svg" alt="" />
          </button>
          <button class="text-[#A0A0C0] hover:text-white text-[1rem]">
            <img class="w-6" src="img/right.svg" alt="" />
          </button>
        </div>
        <div class="flex items-center gap-2 w-full max-w-md">
          <span class="text-[#6B6B8A] text-[1rem]">1:22</span>
          <div class="flex-1 h-1 bg-[#1E1B3A] rounded-full">
            <div class="w-[40%] h-full bg-[#7B6BF5] rounded-full"></div>
          </div>
          <span class="text-[#6B6B8A] text-[1rem]">4:08</span>
        </div>
      </div>

      <button class="md:hidden flex items-center justify-center text-black text-[1rem] shrink-0">
        <img class="w-6" src="img/pause.svg" alt="" />
      </button>

      <div class="hidden md:flex items-center gap-2 w-[20%] justify-end">
        <span class="text-[#6B6B8A] text-[1rem]"><img class="w-6" src="img/volume-solid-full.svg" alt="" /></span>
        <div class="w-20 h-1 bg-[#1E1B3A] rounded-full">
          <div class="w-[70%] h-full bg-[#7B6BF5] rounded-full"></div>
        </div>
      </div>
    </footer>
  </body>
</html>
