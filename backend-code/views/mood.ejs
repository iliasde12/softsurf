<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="./img/softsurf_logo.svg" />
    <script src="js/userData.js" defer></script>
    <title>stemming</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"halyard-display"', "sans-serif"],
              body: ['"halyard-text"', "sans-serif"],
            },
            colors: {
              base: "#0f0e17",
              surface: "#1a1828",
              card: "#221f33",
              border: "#2e2b42",
              accent: "#7c6aff",
              green: "#4ade80",
              red: "#f87171",
              muted: "#6b6889",
              light: "#e8e6f0",
            },
            keyframes: {
              fadeUp: {
                "0%": { opacity: "0", transform: "translateY(14px)" },
                "100%": { opacity: "1", transform: "translateY(0)" },
              },
            },
            animation: {
              fadeUp: "fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both",
            },
          },
        },
      };
    </script>
    <script>
function showMood(moodId) {
  // verberg alle secties
  document.querySelectorAll('.mood-section').forEach(s => s.classList.add('hidden'));
  document.querySelectorAll('.mood-btn').forEach(b => b.classList.remove('border-2', 'border-[#7B6BF5]'));

  // toon geselecteerde
  document.getElementById(`songs-${moodId}`).classList.remove('hidden');
  document.getElementById(`mood-${moodId}`).classList.add('border-2', 'border-[#7B6BF5]');
}
</script>


  </head>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <!-- HEADER -->
    <header class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start">
      <button class="md:hidden text-white text-xl">☰</button>
      <img src="/img/softsurf_logo.svg" alt="softsurf_logo" class="w-28 md:w-30 mx-auto md:mx-0" />
      <div class="md:hidden w-6"></div>
    </header>

    <div class="flex flex-1 overflow-hidden">
       <%- include('partials/aside') %>

      <!-- MAIN -->
    <main class="flex-1 p-4 md:p-6 overflow-y-auto">
      <h1 class="font-display text-3xl font-semibold tracking-tight animate-fadeUp text-light">Stel Je Stemming In</h1>
      <p class="text-[#6B6B8A] text-xs animate-fadeUp md:text-sm mb-6">Je huidige stemming beïnvloedt aanbevelingen en de playlist generator</p>

      <!-- Mood knoppen -->
      <div class="grid grid-cols-2 md:grid-cols-6 gap-3 mb-8 animate-fadeUp">
        <% moods.forEach(mood => { %>
          <div
            onclick="showMood(<%= mood.id %>)"
            id="mood-<%= mood.id %>"
            class="mood-btn rounded-xl p-4 text-center cursor-pointer transition border-2 border-transparent"
            style="background-color: <%= mood.color %>"
          >
            <div class="text-2xl mb-2"><%= mood.emoji %></div>
            <p class="text-white text-xs font-semibold"><%= mood.name %></p>
            <p class="text-[#6B6B8A] text-[10px]"><%= mood.description %></p>
          </div>
        <% }) %>
      </div>

      <!-- Songs per mood -->
      <% moods.forEach(mood => { %>
        <div id="songs-<%= mood.id %>" class="mood-section hidden">
          <div class="flex justify-between items-center mb-4">
          <h2 class="text-base md:text-lg font-bold text-white">
  <%= mood.emoji %> Aanbevolen voor <%= mood.name %>
</h2>

          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <% if (songs[mood.id] && songs[mood.id].length > 0) { %>
              <% songs[mood.id].forEach(song => { %>
                <div class="bg-gradient-to-br from-[#2A1B4A] to-[#1B1B3A] rounded-xl p-3 hover:scale-105 transition cursor-pointer"
                     data-song-id="<%= song._id %>"
                     data-song-name="<%= song.name %>"
                     data-song-artist="<%= song.artists?.[0]?.name ?? '' %>">
                  <% if (song.album && song.album.images && song.album.images.length > 0) { %>
                    <img
                      src="<%= song.album.images[1].url %>"
                      alt="<%= song.name %>"
                      class="w-full h-24 md:h-28 rounded-lg mb-3 object-cover"
                    />
                  <% } else { %>
                    <div class="w-full h-24 md:h-28 bg-[#2A1B4A] rounded-lg mb-3 flex items-center justify-center text-2xl">🎵</div>
                  <% } %>
                  <p class="text-white text-sm font-semibold truncate"><%= song.name %></p>
                  <p class="text-[#6B6B8A] text-xs"><%= song.artists?.[0]?.name ?? 'Onbekend' %></p>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-[#6B6B8A] text-sm col-span-4">Geen nummers voor deze stemming.</p>
            <% } %>
          </div>
        </div>
      <% }) %>

    </main>
    </div>

    <script>
      document.querySelectorAll('[data-song-id]').forEach(card => {
        card.addEventListener('click', async () => {
          const songId = card.dataset.songId;
          const name = card.dataset.songName;
          const artist = card.dataset.songArtist;

          console.log(`${name}: ${artist}`);

          const res = await fetch(`/api/song/${songId}/playable`);
          const playable = await res.json();

          if (playable.youtubeId) {
            playSong(playable.youtubeId, name, artist);
          }
        });
      });
    </script>


    <%- include('partials/footer') %>


