<%- include('partials/head') %>
<link rel="stylesheet" href="/css/register.css" />
<script src="/js/register.js" async></script>
<body>
  <header class="bg-[#100E22] h-16 flex items-center overflow-hidden">
    <img src="/img/softsurf_logo.svg" alt="softsurf_logo" class="w-28 md:w-30 mx-auto md:mx-0" />
  </header>

  <main>
    <div class="container-box">
      <div class="container-buttons">
        <button><a href="/login">Inloggen</a></button>
        <button><a href="/register">Registreren</a></button>
      </div>

      <div class="container-message" style="display: none"></div>

      <div class="container-text">
        <h2>Account aanmaken</h2>
        <p>Maak een account aan om je favoriete nummers op te slaan</p>
        <p>en playlists te genereren.</p>
      </div>

   <form method="post" action="/register" id="form">
    <div class="form-input">
        <label for="weergavenaam">GEBRUIKERSNAAM</label>
        <input type="text" id="weergavenaam" name="username" placeholder="Hoe wil je genoemd worden?" />
    </div>

    <div class="form-input">
        <label for="email">E-MAILADRES</label>
        <input type="email" id="email" name="email" placeholder="jouw@email.be" />
    </div>

    <div class="form-input">
        <label for="wachtwoord">WACHTWOORD</label>
        <input type="password" id="wachtwoord" name="password" placeholder="Minimaal 8 tekens" />
        <div class="container-bar">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </div>
        <span class="text">Wachtwoordsterkte</span>
    </div>

    <div class="form-input">
        <label for="wachtwoord2">BEVESTIG WACHTWOORD</label>
        <input type="password" id="wachtwoord2" name="password2" placeholder="Minimaal 8 tekens" />
    </div>

    <div>
        <label>KIES JE AVATAR</label>
        <div class="container-avatars-icon">
            <% avatars.forEach((avatar, index) => { %>
                <span class="circkel-img <%= index === 0 ? 'circkel-active' : '' %>">
                    <img src="<%= avatar.url %>" alt="<%= avatar.alt %>" />
                </span>
            <% }) %>
        </div>
        <input type="hidden" name="avatar" id="avatar-input" value="<%= avatars[0].url %>" />
        <input type="submit" value="Account aanmaken" />
    </div>
</form>
    </div>
  </main>
</body>

</html>