<%- include('partials/head') %>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <!-- HEADER -->
    <header
      class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start"
    >
      <button class="md:hidden text-white text-xl">☰</button>
      <img
        src="/img/softsurf_logo.svg"
        alt="softsurf_logo"
        class="w-28 md:w-30 mx-auto md:mx-0"
      />
      <div class="md:hidden w-6"></div>
    </header>

    <div class="flex flex-1 overflow-hidden">
      <%- include('partials/aside') %>

      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <!-- Title -->
        <div class="animate-fadeUp mb-4">
          <h1
            class="font-display text-3xl font-semibold tracking-tight text-light"
          >
            Vergelijken
          </h1>
          <p class="mt-1 text-base text-muted">
            Selecteer twee artiesten om hun statistieken naast elkaar te zien
          </p>
        </div>

        <!-- Search -->
        <div
          class="relative animate-fadeUp mb-6"
          style="animation-delay: 0.05s"
        >
          <svg
            class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input
            type="search"
            placeholder="Zoek een artiest…"
            class="w-full bg-surface border border-border rounded-xl pl-10 pr-4 py-2.5 text-sm text-light placeholder-muted outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition"
          />
        </div>

        <!-- Tabs -->
        <div
          class="flex gap-2 mb-8 animate-fadeUp"
          style="animation-delay: 0.1s"
        >
          <a
            href="/vergelijken-artiesten"
            class="px-4 py-1.5 rounded-full text-sm font-medium bg-gradient-to-br from-accent to-violet-400 text-white shadow-lg shadow-accent/30 border border-transparent"
          >
            Artiesten
          </a>
          <a
            href="/vergelijken-nummers"
            class="px-4 py-1.5 rounded-full text-sm font-medium border border-border text-muted hover:text-light hover:border-violet-700 transition"
            >Nummers</a
          >
        </div>
        <!-- Compare grid -->
        <div
          class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-4 items-start animate-fadeUp"
          style="animation-delay: 0.15s"
        >
          <!-- ── Burna Boy ── -->
          <div
            class="bg-gradient-to-b from-card to-surface border border-border rounded-2xl overflow-hidden shadow-xl transition hover:border-accent/40"
          >
            <!-- Card header -->
            <div
              class="flex flex-col items-center gap-3 px-6 pt-7 pb-5 border-b border-border"
            >
              <div
                class="w-20 h-20 rounded-2xl flex items-center justify-center text-4xl shadow-lg"
              >
                <img id="profiel-pic-eerste-artist" class="rounded-xl" />
              </div>
              <div class="text-center">
                <h2
                  class="font-display text-xl font-semibold text-light"
                  id="naam-eerste-artist"
                ></h2>
                <p class="text-[1rem] text-muted mt-0.5">
                  Artiest · Nigeriaans
                </p>
              </div>
            </div>
            <!-- Stats -->
            <div class="px-5 py-2">
              <div
                class="py-3.5 border-b border-border group hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <!----->
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Populariteit</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-[1rem] font-semibold text-green"
                  >
                    <span
                      class="grid place-items-center w-[20px] h-[20px] rounded-full shrink-0"
                      style="background: rgba(74, 222, 128, 0.15)"
                    >
                      <svg
                        width="10"
                        height="10"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#4ade80"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="2,6 5,9 10,3" />
                      </svg>
                    </span>
                    <span id="pop-eerste-artist"></span>
                  </span>
                </div>
                <!----->

                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400"
                    style="width: 88%"
                  ></div>
                </div>
              </div>
              <div
                class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Volgers</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-[1rem] font-semibold text-green"
                  >
                    <span
                      class="grid place-items-center w-[20px] h-[20px] rounded-full shrink-0"
                      style="background: rgba(74, 222, 128, 0.15)"
                    >
                      <svg
                        width="10"
                        height="10"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#4ade80"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="2,6 5,9 10,3" />
                      </svg>
                    </span>
                    <span id="followers-eerste-artist"></span>
                  </span>
                  <!---->
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400"
                    style="width: 82%"
                  ></div>
                </div>
              </div>
              <div
                class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Albums</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-base font-semibold text-red"
                  >
                    <span
                      class="w-[20px] h-[20px] rounded-full flex items-center justify-center shrink-0"
                      style="background: rgba(248, 113, 113, 0.15)"
                    >
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#f87171"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <line x1="3" y1="3" x2="9" y2="9" />
                        <line x1="9" y1="3" x2="3" y2="9" />
                      </svg>
                    </span>
                    7
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-red to-red/60"
                    style="width: 44%"
                  ></div>
                </div>
              </div>
              <div
                class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Maandelijkse luisteraars</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-[1rem] font-semibold text-green"
                  >
                    <span
                      class="grid place-items-center w-[20px] h-[20px] rounded-full shrink-0"
                      style="background: rgba(74, 222, 128, 0.15)"
                    >
                      <svg
                        width="10"
                        height="10"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#4ade80"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="2,6 5,9 10,3" />
                      </svg>
                    </span>
                    42M
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400"
                    style="width: 76%"
                  ></div>
                </div>
              </div>
              <div class="py-3.5 flex justify-between items-center px-1">
                <span
                  class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                  >Genre</span
                >
                <span
                  class="text-[0.7rem] font-semibold px-3 py-1 rounded-full bg-accent/10 text-violet-400 border border-accent/20"
                  >Afrobeats</span
                >
              </div>
            </div>
          </div>
          <!-- VS -->
          <div class="flex items-center justify-center py-8 md:py-0 md:mt-28">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center text-xs font-bold text-white tracking-widest"
              style="
                background: linear-gradient(135deg, #5b3fe8, #7c6aff);
                box-shadow:
                  0 0 0 3px rgba(124, 106, 255, 0.22),
                  0 0 24px rgba(124, 106, 255, 0.18);
              "
            >
              VS
            </div>
          </div>
          <!-- ── Wizkid ── -->
          <div
            class="bg-gradient-to-b from-card to-surface border border-border rounded-2xl overflow-hidden shadow-xl transition hover:border-accent/40"
          >
            <!-- Card header -->
            <div
              class="flex flex-col items-center gap-3 px-6 pt-7 pb-5 border-b border-border"
            >
              <div
                class="w-20 h-20 rounded-2xl flex items-center justify-center text-4xl shadow-lg"
              >
                <img id="profiel-pic-tweede-artist" class="rounded-xl" />
              </div>
              <div class="text-center">
                <h2
                  class="font-display text-xl font-semibold text-light"
                  id="naam-tweede-artist"
                ></h2>
                <p class="text-[1rem] text-muted mt-0.5">
                  Artiest · Nigeriaans
                </p>
              </div>
            </div>
            <!-- Stats -->
            <div class="px-5 py-2">
              <div
                class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Populariteit</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-base font-semibold text-red"
                  >
                    <span
                      class="w-[20px] h-[20px] rounded-full flex items-center justify-center shrink-0"
                      style="background: rgba(248, 113, 113, 0.15)"
                    >
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#f87171"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <line x1="3" y1="3" x2="9" y2="9" />
                        <line x1="9" y1="3" x2="3" y2="9" />
                      </svg>
                    </span>
                    <span id="pop-tweede-artist"></span>
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-red to-red/60"
                    style="width: 85%"
                  ></div>
                </div>
              </div>
              <div
                class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Volgers</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-base font-semibold text-red"
                  >
                    <span
                      class="w-[20px] h-[20px] rounded-full flex items-center justify-center shrink-0"
                      style="background: rgba(248, 113, 113, 0.15)"
                    >
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#f87171"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <line x1="3" y1="3" x2="9" y2="9" />
                        <line x1="9" y1="3" x2="3" y2="9" />
                      </svg>
                    </span>
                    <span id="followers-tweede-artist"></span>
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-red to-red/60"
                    style="width: 67%"
                  ></div>
                </div>
              </div>
              <div
                class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Albums</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-[1rem] font-semibold text-green"
                  >
                    <span
                      class="grid place-items-center w-[20px] h-[20px] rounded-full shrink-0"
                      style="background: rgba(74, 222, 128, 0.15)"
                    >
                      <svg
                        width="10"
                        height="10"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#4ade80"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="2,6 5,9 10,3" />
                      </svg>
                    </span>
                    9
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-accent to-violet-400"
                    style="width: 56%"
                  ></div>
                </div>
              </div>
              <div
                class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition"
              >
                <div class="flex justify-between items-center">
                  <span
                    class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                    >Maandelijkse luisteraars</span
                  >
                  <span
                    class="flex items-center gap-1.5 text-base font-semibold text-red"
                  >
                    <span
                      class="w-[20px] h-[20px] rounded-full flex items-center justify-center shrink-0"
                      style="background: rgba(248, 113, 113, 0.15)"
                    >
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="#f87171"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <line x1="3" y1="3" x2="9" y2="9" />
                        <line x1="9" y1="3" x2="3" y2="9" />
                      </svg>
                    </span>
                    36M
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-red to-red/60"
                    style="width: 65%"
                  ></div>
                </div>
              </div>
              <div class="py-3.5 flex justify-between items-center px-1">
                <span
                  class="text-[1rem] font-medium uppercase tracking-widest text-white/75"
                  >Genre</span
                >
                <span
                  class="text-[0.7rem] font-semibold px-3 py-1 rounded-full bg-accent/10 text-violet-400 border border-accent/20"
                  >Afropop</span
                >
              </div>
            </div>
          </div>
        </div>
        <!-- /grid -->
        <!-- Summary -->
        <div
          class="mt-6 flex flex-wrap items-center justify-between gap-3 border border-border bg-card/50 rounded-xl px-6 py-4 animate-fadeUp"
          style="animation-delay: 0.2s"
        >
          <p class="text-sm text-muted">
            <span class="text-light font-semibold">Burna Boy</span>
            scoort hoger op populariteit, volgers en luisteraars.
            <span class="text-light font-semibold">Wizkid</span>
            heeft meer albums uitgebracht.
          </p>
          <div class="flex gap-4 shrink-0">
            <span
              class="flex items-center gap-1.5 text-[1rem] text-green font-medium"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 12 12"
                fill="none"
                stroke="#4ade80"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="2,6 5,9 10,3" />
              </svg>
              Winnaar
            </span>
            <span
              class="flex items-center gap-1.5 text-[1rem] text-red font-medium"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 12 12"
                fill="none"
                stroke="#f87171"
                stroke-width="2"
                stroke-linecap="round"
              >
                <line x1="3" y1="3" x2="9" y2="9" />
                <line x1="9" y1="3" x2="3" y2="9" />
              </svg>
              Lager
            </span>
          </div>
        </div>
      </main>
    </div>

    <!-- FOOTER -->
 <%- include('partials/footer') %>
  </body>
</html>
