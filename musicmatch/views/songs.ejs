<%- include('partials/head') %>
<script src="/js/songs.js" defer></script>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <%- include('partials/header') %>

    <div class="flex flex-1 overflow-hidden">
      <%- include('partials/aside') %>

      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">

        <!-- Title -->
        <div class="flex items-start justify-between mb-4 animate-fadeUp">
          <div>
            <h1 class="font-display text-3xl font-semibold tracking-tight text-light">Nummers</h1>
            <p class="text-[#6B6B8A] text-xs md:text-sm">Alle nummers in je bibliotheek</p>
          </div>
        </div>

        <!-- Search -->
        <div class="mb-6 animate-fadeUp">
          <div class="relative">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.35-4.35" />
            </svg>
            <input
              type="search"
              id="searchInput"
              placeholder="Zoek een nummer of artiest…"
              class="w-full bg-surface border border-border rounded-xl pl-10 pr-4 py-2.5 text-sm text-light placeholder-muted outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition"
            />
          </div>
        </div>

        <!-- Table header -->
        <div class="hidden md:grid grid-cols-[40px_1fr_160px_100px_40px] gap-2 text-[#6B6B8A] text-xs uppercase tracking-widest mb-2 px-2 animate-fadeUp">
          <span>#</span>
          <span>Titel</span>
          <span>Label</span>
          <span>Datum</span>
          <span></span>
        </div>

        <!-- Tracks -->
        <div class="flex flex-col gap-1 animate-fadeUp" id="containerSongs">
          <% songs.forEach((song, index) => { %>
            <% const artistName = song.artists && song.artists[0] ? song.artists[0].name : 'Onbekend'; %>
            <% const albumImg = song.album && song.album.images && song.album.images[0] ? song.album.images[0].url : '/img/default.svg'; %>
            <% const releaseDate = song.album && song.album.release_date ? new Date(song.album.release_date).toLocaleDateString('nl-NL', { day: 'numeric', month: 'short' }) : ''; %>
            <% const isFavorite = song.userSong && song.userSong.isFavorite; %>

            <div class="song-row playable-song grid grid-cols-[40px_1fr_40px] md:grid-cols-[40px_1fr_160px_100px_40px] gap-2 items-center <%= index % 2 === 0 ? 'bg-[#1E1B3A]' : '' %> hover:bg-[#2A2750] rounded-xl px-2 py-2 cursor-pointer transition"
                 data-name="<%= song.name.toLowerCase() %>"
                 data-artist="<%= artistName.toLowerCase() %>"
                 data-song-id="<%= song._id %>"
                 data-song-name="<%= song.name %>"
                 data-song-artist="<%= artistName %>">

              <!-- Nummer -->
              <span class="text-[#6B6B8A] text-sm text-center"><%= index + 1 %></span>

              <!-- Info -->
              <div class="flex items-center gap-3">
                <img src="<%= albumImg %>" alt="<%= song.name %>" class="w-9 h-9 rounded-lg object-cover shrink-0" />
                <div>
                  <p class="text-white text-sm font-semibold"><%= song.name %></p>
                  <p class="text-[#6B6B8A] text-xs"><%= artistName %></p>
                </div>
              </div>

              <!-- Mood select -->
              <select class="mood-select hidden md:block bg-[#2A2750] text-white text-xs rounded-full px-2 py-1 border-none cursor-pointer"
                      data-song-id="<%= song._id %>">
                <option value="">geen</option>
                <% moods.forEach(function(mood) { %>
                  <option value="<%= mood.id %>" <%= song.userSong && song.userSong.mood === mood.id ? 'selected' : '' %>>
                    <%= mood.emoji || '' %> <%= mood.name || '' %>
                  </option>
                <% }) %>
              </select>

              <!-- Datum -->
              <span class="hidden md:block text-[#6B6B8A] text-xs"><%= releaseDate %></span>

              <!-- Heart -->
              <span
                class="heart text-sm cursor-pointer transition <%= isFavorite ? 'text-[#E91E8C]' : 'text-[#6B6B8A]' %>"
                data-song-id="<%= song._id %>"
                data-favorite="<%= isFavorite ? 'true' : 'false' %>"
              >♥</span>
            </div>
          <% }) %>
        </div>
      </main>
    </div>

    <!-- FOOTER -->
    <script>
      document.querySelectorAll('.playable-song').forEach(card => {
        card.addEventListener('click', async () => {
          const songId = card.dataset.songId;
          const name = card.dataset.songName;
          const artist = card.dataset.songArtist;

          console.log(`${name}: ${artist}`);

          const res = await fetch(`/api/song/${songId}/playable`);
          const playable = await res.json();

          if (playable.youtubeId) {
            playSong(playable.youtubeId, name, artist);
          }
        });
      });
    </script>

    <!-- FOOTER -->
    <%- include('partials/footer') %>
  </body>
</html>
