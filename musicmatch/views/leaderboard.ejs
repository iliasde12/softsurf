<%- include('partials/head') %>

<body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
<%- include('partials/header') %>

<div class="flex flex-1 overflow-hidden">
    <%- include('partials/aside') %>

    <main class="flex-1 p-4 md:p-8 overflow-y-auto">
        <div class="max-w-2xl mx-auto animate-fadeUp">

            <!-- Titel -->
            <div class="mb-8">
                <h1 class="font-display text-3xl font-semibold tracking-tight text-light">Leaderboard</h1>
                <p class="mt-1 text-base text-muted">De beste spelers van MusicMatch</p>
            </div>

            <!-- Jouw positie -->
            <div class="rounded-2xl px-6 py-4 mb-6 flex items-center gap-4" style="background:linear-gradient(135deg,rgba(124,106,255,0.15),rgba(168,85,247,0.1));border:1px solid rgba(124,106,255,0.3)">
                <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg shrink-0" style="background:linear-gradient(135deg,#7c6aff,#a855f7)">
                    #<%= userRank %>
                </div>
                <div class="flex-1">
                    <p class="font-semibold text-light">Jouw positie</p>
                    <p class="text-muted text-sm">
                        <%= currentUser.totalScore %> punten ·
                        <%= currentUser.gamesPlayed %> gespeeld ·
                        beste reeks <%= currentUser.bestStreak %>
                    </p>
                </div>
                <div class="shrink-0">
                    <% if (currentUser.avatar?.url) { %>
                        <img src="<%= currentUser.avatar.url %>" class="w-10 h-10 rounded-full object-cover" alt="avatar" />
                    <% } else { %>
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg" style="background:#2a2648">
                            <%= currentUser.username.charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Leeg of gevuld -->
            <% const heeftScores = topUsers.some(u => u.totalScore > 0); %>

            <% if (!heeftScores) { %>

                <!-- Lege staat -->
                <div class="rounded-2xl px-6 py-14 text-center" style="background:#1a1730;border:1px solid #2a2648">
                    <div class="text-5xl mb-4">🎮</div>
                    <p class="font-semibold text-light text-lg mb-2">Nog geen scores</p>
                    <p class="text-muted text-sm mb-6">Speel Raad het Nummer om als eerste op het leaderboard te komen!</p>
                    <a href="/guessthesong" class="inline-block px-6 py-3 rounded-full font-semibold text-white text-sm transition-transform hover:scale-105"
                       style="background:linear-gradient(135deg,#7c6aff,#a855f7)">
                        Start het spel
                    </a>
                </div>

            <% } else { %>

                <!-- Top 10 -->
                <div class="rounded-2xl overflow-hidden" style="background:#1a1730;border:1px solid #2a2648">
                    <% topUsers.forEach((user, i) => { %>
                        <div class="flex items-center gap-4 px-6 py-4 <%= i < topUsers.length - 1 ? 'border-b border-[#2a2648]' : '' %> <%= currentUser._id?.toString() === user._id?.toString() ? 'bg-accent/5' : '' %> hover:bg-white/5 transition">

                            <!-- Rank -->
                            <div class="w-8 text-center shrink-0">
                                <% if (i === 0) { %>
                                    <span class="text-xl">🥇</span>
                                <% } else if (i === 1) { %>
                                    <span class="text-xl">🥈</span>
                                <% } else if (i === 2) { %>
                                    <span class="text-xl">🥉</span>
                                <% } else { %>
                                    <span class="font-bold text-muted">#<%= i + 1 %></span>
                                <% } %>
                            </div>

                            <!-- Avatar -->
                            <% if (user.avatar?.url) { %>
                                <img src="<%= user.avatar.url %>" class="w-10 h-10 rounded-full object-cover shrink-0" alt="avatar" />
                            <% } else { %>
                                <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold shrink-0" style="background:#2a2648;color:#a79bfa">
                                    <%= user.username.charAt(0).toUpperCase() %>
                                </div>
                            <% } %>

                            <!-- Naam + stats -->
                            <div class="flex-1 min-w-0">
                                <p class="font-semibold text-light truncate">
                                    <%= user.username %>
                                    <% if (currentUser._id?.toString() === user._id?.toString()) { %>
                                        <span class="text-xs font-normal text-accent ml-1">(jij)</span>
                                    <% } %>
                                </p>
                                <p class="text-muted text-sm">
                                    <%= user.gamesPlayed %> gespeeld ·
                                    beste reeks <%= user.bestStreak %>
                                </p>
                            </div>

                            <!-- Score -->
                            <div class="text-right shrink-0">
                                <% if (user.totalScore > 0) { %>
                                    <p class="font-bold text-lg" style="color:#a79bfa"><%= user.totalScore %></p>
                                    <p class="text-muted text-xs">punten</p>
                                <% } else { %>
                                    <p class="text-muted text-sm">Nog niet gespeeld</p>
                                <% } %>
                            </div>

                        </div>
                    <% }) %>
                </div>

            <% } %>

        </div>
    </main>
</div>

<!-- FOOTER -->
<%- include('partials/footer') %>

