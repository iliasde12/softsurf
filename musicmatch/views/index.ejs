<%- include('partials/head') %>
<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
<style>
  body { font-family: "halyard-text", sans-serif; background: #0b0c1e; }
  .theme-music { background: radial-gradient(ellipse at 30% 20%, #6c5ce7 0%, transparent 65%), radial-gradient(ellipse at 80% 80%, #a29bfe 0%, transparent 60%), #11142a; }
  .theme-game { background: radial-gradient(ellipse at 40% 30%, #2d6a4f 0%, transparent 65%), radial-gradient(ellipse at 70% 75%, #52b788 0%, transparent 60%), #11142a; }
  .theme-lego { background: radial-gradient(ellipse at 35% 25%, #7b2d00 0%, transparent 65%), radial-gradient(ellipse at 75% 70%, #e07b39 0%, transparent 60%), #11142a; }
  .card { transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .card:hover { transform: translateY(-6px) scale(1.015); }
  .delay-1 { animation-delay: 0.1s; opacity: 0; }
  .delay-2 { animation-delay: 0.2s; opacity: 0; }
  .delay-3 { animation-delay: 0.3s; opacity: 0; }
  .delay-4 { animation-delay: 0.4s; opacity: 0; }
</style>

  <body class="min-h-screen text-white overflow-x-hidden">
    <!-- NAVBAR -->
    <header
  class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start"
>
  
  <img
    src="/img/softsurf_logo.svg"
    alt="softsurf_logo"
    class="w-28 md:w-30 mx-auto md:mx-0"
  />
  <div class="md:hidden w-6"></div>
</header>

<script>
  function toggleMenu() {
    const aside = document.querySelector('aside');
    aside.classList.toggle('hidden');
    aside.classList.toggle('flex');
  }

  document.getElementById('menuBtn').addEventListener('click', toggleMenu);

  // close button inside the aside
  document.addEventListener('DOMContentLoaded', () => {
    const closeBtn = document.getElementById('closeMenuBtn');
    if (closeBtn) closeBtn.addEventListener('click', toggleMenu);
  });
</script>


    <!-- MAIN -->
    <main class="max-w-[900px] mx-auto px-5 sm:px-8 py-16 sm:py-24">
      <!-- Hero -->
      <section class="text-center mb-14 animate-fade-up delay-1">
        <h1
          class="font-display font-extrabold text-[clamp(2rem,5vw,3rem)] tracking-tight leading-tight text-white mb-3"
        >
          KIES JE APP
        </h1>
        <p class="text-base text-white/75 max-w-xl mx-auto">
          Selecteer een project om te beginnen. Je moet ingelogd zijn om toegang
          te krijgen tot je persoonlijke collectie en functies.
        </p>
      </section>

      <!-- Cards -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- MusicMatch — goes to /musicmatch -->
        <a
          href="/login"
          class="card theme-music rounded-[20px] border border-[#7c6fff]/40 overflow-hidden min-h-[260px] flex flex-col shadow-[0_8px_32px_rgba(124,111,255,0.12)] sm:col-span-2 lg:col-span-1 animate-fade-up delay-2"
        >
          <div class="flex-1 flex items-center justify-center py-10">
            <svg
              style="width: 3.5rem; height: 3.5rem"
              class="text-white/80"
              viewBox="0 0 40 40"
              fill="none"
            >
              <path
                d="M16 30V14l16-4v16"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <circle
                cx="12"
                cy="30"
                r="4"
                stroke="currentColor"
                stroke-width="2"
              />
              <circle
                cx="28"
                cy="26"
                r="4"
                stroke="currentColor"
                stroke-width="2"
              />
            </svg>
          </div>
          <div
            class="bg-[#0b0c1e]/70 backdrop-blur-sm px-5 py-4 border-t border-white/[0.08]"
          >
            <h2 class="font-display font-bold text-lg text-white mb-0.5">
              MusicMatch
            </h2>
            <p class="text-base text-white/75 leading-snug mb-3">
              Ontdek, vergelijk en bewaar muziek via de Spotify API.
            </p>
            <span
              class="text-sm font-bold tracking-[0.1em] uppercase px-3 py-[0.3rem] rounded-lg bg-[#7c6fff] text-white block w-fit mx-auto"
              >START APP</span
            >
          </div>
        </a>

        <!-- GameHub — shows popup -->
        <div
          onclick="document.getElementById('popup').classList.remove('hidden')"
          class="card theme-game rounded-[20px] border border-white/[0.07] overflow-hidden min-h-[260px] flex flex-col cursor-pointer animate-fade-up delay-3"
        >
          <div class="flex-1 flex items-center justify-center py-10">
            <ion-icon
              name="game-controller-outline"
              style="font-size: 3.5rem; color: rgba(255, 255, 255, 0.8)"
            ></ion-icon>
          </div>
          <div
            class="bg-[#0b0c1e]/70 backdrop-blur-sm px-5 py-4 border-t border-white/[0.06]"
          >
            <h2 class="font-display font-bold text-lg text-white mb-0.5">
              GameHub
            </h2>
            <p class="text-base text-white/75 leading-snug mb-3">
              Beheer jouw videogames en vind iets leuks.
            </p>
            <span
              class="text-sm font-bold tracking-[0.1em] uppercase px-3 py-[0.3rem] rounded-lg bg-[#7c6fff] text-white block w-fit mx-auto"
              >START APP</span
            >
          </div>
        </div>

        <!-- Legomasters — shows popup -->
        <div
          onclick="document.getElementById('popup').classList.remove('hidden')"
          class="card theme-lego rounded-[20px] border border-white/[0.07] overflow-hidden min-h-[260px] flex flex-col cursor-pointer animate-fade-up delay-4"
        >
          <div class="flex-1 flex items-center justify-center py-10">
            <ion-icon
              name="build-outline"
              style="font-size: 3.5rem; color: rgba(255, 255, 255, 0.8)"
            ></ion-icon>
          </div>
          <div
            class="bg-[#0b0c1e]/70 backdrop-blur-sm px-5 py-4 border-t border-white/[0.06]"
          >
            <h2 class="font-display font-bold text-lg text-white mb-0.5">
              Legomasters
            </h2>
            <p class="text-base text-white/75 leading-snug mb-3">
              Bouw jouw lego sets en maak er meer van.
            </p>
            <span
              class="text-sm font-bold tracking-[0.1em] uppercase px-3 py-[0.3rem] rounded-lg bg-[#7c6fff] text-white block w-fit mx-auto"
              >START APP</span
            >
          </div>
        </div>
      </section>
    </main>

    <!-- POPUP -->
    <div
      id="popup"
      class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm"
    >
      <div
        class="bg-[#11142a] border border-[#7c6fff]/40 rounded-2xl px-10 py-8 max-w-sm w-full text-center shadow-[0_0_40px_rgba(124,111,255,0.2)]"
      >
        <h2 class="font-display font-bold text-2xl text-white mb-3">
          geen toegang
        </h2>
        <p class="text-white/60 text-sm leading-relaxed mb-6">
          Je kunt niet deelnemen aan dit project.
          <br />
          Selecteer een ander project om verder te gaan.
        </p>
        <button
          onclick="document.getElementById('popup').classList.add('hidden')"
          class="px-8 py-2 rounded-full border border-[#7c6fff]/60 text-white/80 text-sm hover:bg-[#7c6fff]/20 transition-all duration-200"
        >
          OK
        </button>
      </div>
    </div>
  </body>
</html>
