<%- include('partials/head') %>
<script src="/js/collectie.js" defer></script>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <%- include('partials/header') %>

    <div class="flex flex-1 overflow-hidden">
      <%- include('partials/aside') %>


      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <!-- Title + view toggle -->
        <div class="flex items-start justify-between mb-1 animate-fadeUp">
          <div>
            <h1 class="font-display text-3xl font-semibold tracking-tight text-light ">Mijn Collectie</h1>
            <p class="text-[#6B6B8A] text-xs md:text-sm mb-4 ">Je gelikte nummers, georganiseerd en klaar om af te spelen</p>
          </div>
          <div class="flex gap-2 mt-1">
            <button id="lijstBtn" class="bg-[#7B6BF5] text-white text-xs px-3 py-1 rounded-full">Lijst</button>
            <button id="rasterBtn" class="border border-[#3A3760] text-[#A0A0C0] text-xs px-3 py-1 rounded-full hover:bg-[#1E1B3A] transition">Raster</button>
          </div>
        </div>

        <!-- Search + filters -->
        <div class="flex flex-col md:flex-row gap-3 mb-6 animate-fadeUp">
          <div class="relative flex-1 md:max-w-full">
            <div
          class="relative"
          style="animation-delay: 0.05s"
        >
          <svg
            class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
              <input
                      type="search"
                      id="searchInput"
                      placeholder="Zoek een artiest…"
                      class="w-full bg-surface border border-border rounded-xl pl-10 pr-4 py-2.5 text-sm text-light placeholder-muted outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition"
              />
        </div>
            </div>
        </div>

        <!-- Table header (hidden on mobile) -->
        <div class="hidden md:grid grid-cols-[40px_1fr_160px_100px_80px_40px] gap-2 text-[#6B6B8A] text-base uppercase tracking-widest mb-2 px-2 animate-fadeUp">
          <span class="text-white">#</span>
          <span class="text-white">Titel</span>
          <span class="text-white">Label</span>
          <span class="text-white">Datum</span>
          <!--<span class="text-white">Pop</span>-->
         <span class="text-white"></span>
       </div>

       <!-- Tracks -->
        <div class="flex flex-col gap-1" id="containerSongs"></div>
      </main>
    </div>

    <!-- FOOTER -->
    <%- include('partials/footer') %>
  </body>
</html>
