<header
  class="bg-[#100E22] h-16 flex items-center px-4 w-full shrink-0 justify-between md:justify-start"
>
  <button id="menuBtn" class="md:hidden text-white text-xl">☰</button>
  <img
    src="/img/softsurf_logo.svg"
    alt="softsurf_logo"
    class="w-28 md:w-30 mx-auto md:mx-0"
  />
  <div class="md:hidden w-6"></div>
</header>

<script>
  function toggleMenu() {
    const aside = document.querySelector('aside');
    aside.classList.toggle('hidden');
    aside.classList.toggle('flex');
  }

  document.getElementById('menuBtn').addEventListener('click', toggleMenu);

  // close button inside the aside
  document.addEventListener('DOMContentLoaded', () => {
    const closeBtn = document.getElementById('closeMenuBtn');
    if (closeBtn) closeBtn.addEventListener('click', toggleMenu);
  });
</script>
