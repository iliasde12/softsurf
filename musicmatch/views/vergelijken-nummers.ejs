<%- include('partials/head') %>

  <body class="flex flex-col h-screen bg-[#0D0B1E] text-white overflow-hidden">
    <%- include('partials/header') %>

    <div class="flex flex-1 overflow-hidden">
       <%- include('partials/aside') %>

      <!-- MAIN -->
      <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <!-- Title -->
        <div class="animate-fadeUp mb-4">
          <h1 class="font-display text-3xl font-semibold tracking-tight text-light">Vergelijken</h1>
          <p class="mt-1 text-sm text-muted">Selecteer twee nummers om hun statistieken naast elkaar te zien</p>
        </div>

        <!-- Search -->
        <div class="relative animate-fadeUp mb-6 z-[100]" style="animation-delay: 0.05s">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input type="search" placeholder="Zoek een nummer…"
            class="w-full bg-surface border border-border rounded-xl pl-10 pr-4 py-2.5 text-sm text-light placeholder-muted outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition" />
        </div>

        <!-- Tabs -->
        <div class="flex gap-2 mb-8 animate-fadeUp" style="animation-delay: 0.1s">
          <a href="/vergelijken-artiesten" class="px-4 py-1.5 rounded-full text-sm font-medium border border-border text-muted hover:text-light hover:border-teal-700 transition">Artiesten</a>
          <a href="/vergelijken-nummers" class="px-4 py-1.5 rounded-full text-sm font-medium bg-gradient-to-br from-teal-500 to-accent text-white shadow-lg shadow-accent/20 border border-transparent">Nummers</a>
        </div>

        <!-- Compare grid -->
        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-4 items-start animate-fadeUp" style="animation-delay: 0.15s">

          <!-- ── Nummer 1 ── -->
          <div class="bg-gradient-to-b from-card to-surface border border-border rounded-2xl overflow-hidden shadow-xl transition hover:border-teal-500/40">
            <div class="flex flex-col items-center gap-3 px-6 pt-7 pb-5 border-b border-border">
              <div class="w-20 h-20 rounded-2xl overflow-hidden shadow-lg">
                <img id="img-eerste-nummer" class="w-full h-full object-cover" src="https://placehold.co/80x80/1a1828/6b6889?text=🎵" />
              </div>
              <div class="text-center">
                <h2 class="font-display text-xl font-semibold text-light" id="naam-eerste-nummer">Nummer 1</h2>
                <p class="text-[1rem] text-muted mt-0.5" id="sub-eerste-nummer">Zoek een nummer hierboven</p>
              </div>
            </div>
            <div class="px-5 py-2">

              <!-- Populariteit -->
              <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
                <div class="flex justify-between items-center">
                  <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Populariteit</span>
                  <span id="icon-popularity-eerste" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span id="popularity-eerste-nummer">–</span>
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div id="bar-popularity-eerste" class="h-full rounded-full bg-gradient-to-r from-teal-600 to-accent" style="width: 0%"></div>
                </div>
              </div>

              <!-- Duur -->
              <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
                <div class="flex justify-between items-center">
                  <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Duur</span>
                  <span id="duration-eerste-nummer" class="text-base font-semibold text-light">–</span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div id="bar-duration-eerste" class="h-full rounded-full bg-gradient-to-r from-muted to-muted/50" style="width: 0%"></div>
                </div>
              </div>

              <!-- Explicit -->
              <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
                <div class="flex justify-between items-center">
                  <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Explicit</span>
                  <span id="explicit-eerste-nummer" class="text-base font-semibold text-light">–</span>
                </div>
              </div>

              <!-- Genre -->
              <div class="py-3.5 flex justify-between items-center px-1">
                <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Genre</span>
                <span id="genre-eerste-nummer" class="text-[0.8rem] font-semibold uppercase px-3 py-1 rounded-full bg-accent/10 text-accent border border-accent/20">–</span>
              </div>

            </div>
          </div>

          <!-- VS -->
          <div class="flex items-center justify-center py-8 md:py-0 md:mt-28">
            <div class="w-16 h-16 rounded-full flex items-center justify-center text-[1rem] font-bold text-white tracking-widest"
              style="background: linear-gradient(135deg, #5b3fe8, #7c6aff); box-shadow: 0 0 0 3px rgba(124,106,255,0.22), 0 0 24px rgba(124,106,255,0.18);">
              VS
            </div>
          </div>

          <!-- ── Nummer 2 ── -->
          <div class="bg-gradient-to-b from-card to-surface border border-border rounded-2xl overflow-hidden shadow-xl transition hover:border-teal-500/40">
            <div class="flex flex-col items-center gap-3 px-6 pt-7 pb-5 border-b border-border">
              <div class="w-20 h-20 rounded-2xl overflow-hidden shadow-lg">
                <img id="img-tweede-nummer" class="w-full h-full object-cover" src="https://placehold.co/80x80/1a1828/6b6889?text=🎵" />
              </div>
              <div class="text-center">
                <h2 class="font-display text-xl font-semibold text-light" id="naam-tweede-nummer">Nummer 2</h2>
                <p class="text-[1rem] text-muted mt-0.5" id="sub-tweede-nummer">Zoek een nummer hierboven</p>
              </div>
            </div>
            <div class="px-5 py-2">

              <!-- Populariteit -->
              <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
                <div class="flex justify-between items-center">
                  <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Populariteit</span>
                  <span id="icon-popularity-tweede" class="flex items-center gap-1.5 text-[1rem] font-semibold text-muted">
                    <span id="popularity-tweede-nummer">–</span>
                  </span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div id="bar-popularity-tweede" class="h-full rounded-full bg-gradient-to-r from-red to-red/60" style="width: 0%"></div>
                </div>
              </div>

              <!-- Duur -->
              <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
                <div class="flex justify-between items-center">
                  <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Duur</span>
                  <span id="duration-tweede-nummer" class="text-base font-semibold text-light">–</span>
                </div>
                <div class="mt-1.5 h-0.5 bg-border rounded-full">
                  <div id="bar-duration-tweede" class="h-full rounded-full bg-gradient-to-r from-muted to-muted/50" style="width: 0%"></div>
                </div>
              </div>

              <!-- Explicit -->
              <div class="py-3.5 border-b border-border hover:bg-accent/5 rounded-lg px-1 transition">
                <div class="flex justify-between items-center">
                  <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Explicit</span>
                  <span id="explicit-tweede-nummer" class="text-base font-semibold text-light">–</span>
                </div>
              </div>

              <!-- Genre -->
              <div class="py-3.5 flex justify-between items-center px-1">
                <span class="text-[1rem] font-medium uppercase tracking-widest text-white/75">Genre</span>
                <span id="genre-tweede-nummer" class="text-[0.8rem] font-semibold uppercase px-3 py-1 rounded-full bg-accent/10 text-accent border border-accent/20">–</span>
              </div>

            </div>
          </div>
        </div>
        <!-- /grid -->

        <!-- Summary -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border border-border bg-card/50 rounded-xl px-6 py-4 animate-fadeUp" style="animation-delay: 0.2s">
          <p class="text-[1rem] text-muted" id="summary-text">Zoek twee nummers om ze te vergelijken.</p>
          <div class="flex gap-4 shrink-0">
            <span class="flex items-center gap-1.5 text-[1rem] text-green font-medium">
              <svg width="15" height="15" viewBox="0 0 12 12" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="2,6 5,9 10,3" />
              </svg>
              Winnaar
            </span>
            <span class="flex items-center gap-1.5 text-[1rem] text-red font-medium">
              <svg width="15" height="15" viewBox="0 0 12 12" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round">
                <line x1="3" y1="3" x2="9" y2="9" /><line x1="9" y1="3" x2="3" y2="9" />
              </svg>
              Lager
            </span>
          </div>
        </div>
      </main>
    </div>

    <script src="/js/vergelijking-nummers.js" defer></script>
    <%- include('partials/footer') %>
  </body>
</html>
